#! /c/Source/iverilog-install/bin/vvp
:ivl_version "14.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "C:\iverilog\lib\ivl\system.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2005_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\va_math.vpi";
S_000001D9C27FA8C0 .scope module, "and_gate_tb" "and_gate_tb" 2 3;
 .timescale -9 -12;
v000001D9C27FABE0_0 .var "a", 0 0;
v000001D9C27FAC80_0 .var "b", 0 0;
v000001D9C27F6F40_0 .net "y", 0 0, L_000001D9C27FAD20;  1 drivers
S_000001D9C27FAA50 .scope module, "uut" "and_gate" 2 11, 3 1 0, S_000001D9C27FA8C0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_000001D9C27FAD20 .functor AND 1, v000001D9C27FABE0_0, v000001D9C27FAC80_0, C4<1>, C4<1>;
v000001D9C27E6A20_0 .net "a", 0 0, v000001D9C27FABE0_0;  1 drivers
v000001D9C27E7000_0 .net "b", 0 0, v000001D9C27FAC80_0;  1 drivers
v000001D9C27E63D0_0 .net "y", 0 0, L_000001D9C27FAD20;  alias, 1 drivers
    .scope S_000001D9C27FA8C0;
T_0 ;
    %vpi_call 2 19 "$dumpfile", "and.vcd" {0 0 0};
    %vpi_call 2 20 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001D9C27FA8C0 {0 0 0};
    %vpi_call 2 22 "$monitor", "Tempo = %0t ns | a = %b, b = %b => y = %b", $time, v000001D9C27FABE0_0, v000001D9C27FAC80_0, v000001D9C27F6F40_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001D9C27FABE0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001D9C27FAC80_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001D9C27FABE0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001D9C27FAC80_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001D9C27FABE0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001D9C27FAC80_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001D9C27FABE0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001D9C27FAC80_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 41 "$finish" {0 0 0};
    %end;
    .thread T_0;
